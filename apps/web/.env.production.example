# Frontend Production Environment Variables Template
# Copy these to Vercel Environment Variables dashboard

# Backend API URL - Update after backend deployment
VITE_BACKEND_URL=https://your-backend.vercel.app/api/v1

# Google Gemini AI
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_API_KEY=your_gemini_api_key_here

# Hugging Face
VITE_HF_TOKEN=your_huggingface_token_here

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# OpenAI (if used)
VITE_OPENAI_API_KEY=your_openai_api_key_here
